<?xml version="1.0"?>
<sdf version="1.9">
  <world name="parking_course">
    <!-- floor 1350 x 1200 mm, origin = robot start (floor mm u=1125, v=1090), +x = towards the parking lot -->
    <model name="floor">
      <static>true</static>
      <pose>0.49 0.45 0 0 0 -1.5708</pose>
      <link name="link">
        <visual name="texture">
          <geometry><plane><normal>0 0 1</normal><size>1.35 1.2</size></plane></geometry>
          <material><pbr><metal><albedo_map>file:///home/sado/dev_ws/pinky_parking_sim/worlds/course_floor.png</albedo_map></metal></pbr></material>
        </visual>
      </link>
    </model>
    <!-- standing panels around the boards (white 0.21 m, cardboard 0.24 m, thickness 0.01 m): left = cardboard, others = white panels -->
    <model name="wall_top">
      <static>true</static>
      <pose>1.0950 0.4500 0.105 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.010 1.370 0.210</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.010 1.370 0.210</size></box></geometry>
          <material><diffuse>0.93 0.93 0.92 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_bottom">
      <static>true</static>
      <pose>-0.1150 0.4500 0.105 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.010 1.370 0.210</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.010 1.370 0.210</size></box></geometry>
          <material><diffuse>0.93 0.93 0.92 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_left">
      <static>true</static>
      <pose>0.4900 1.1300 0.120 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.200 0.010 0.240</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.200 0.010 0.240</size></box></geometry>
          <material><diffuse>0.72 0.58 0.42 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_right">
      <static>true</static>
      <pose>0.4900 -0.2300 0.105 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.200 0.010 0.210</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.200 0.010 0.210</size></box></geometry>
          <material><diffuse>0.93 0.93 0.92 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
